# Copy to .env (.env.local) for local dev. Every value is required except the optional ones and no defaults in code.
# The one base domain: a bare lowercase host name (no scheme, port or path). Every host derives from it: DOMAIN, api./id./admin./exercises.DOMAIN,
# event sites <tag>.DOMAIN, cookies on DOMAIN. There are no per-host settings.
NEXT_PUBLIC_DOMAIN=cybericebox.example
# Support mailbox of the «Send feedback» link.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Optional installation settings, none by default (empty = not shown). A URL is empty or https://host[/path].
# NEXT_PUBLIC_MAIN_SITE_URL=            # logo target and "home" button (empty: the logo leads to / of this site, no home button)
# NEXT_PUBLIC_COOKIES_URL=              # Cookie Policy link (empty: no link in the cookie banner)
# NEXT_PUBLIC_RETENTION_URL=            # retention file of the Privacy Policy (empty: the retention settings are not compared with a Policy, nothing is fetched)
DEV_ALLOWED_ORIGINS=
# Container listeners (nginx image only, runtime env, see README "Listeners and TLS"). All optional; the defaults are baked into the image.
# HTTP_PORT=8080
# HTTPS_PORT=8443
# TLS_CERT_FILE=/tls/tls.crt (TLS is on when both files exist; a given path must exist)
# TLS_KEY_FILE=/tls/tls.key
# TLS_MIN_VERSION=1.2
# TLS_CLIENT_CA_FILE=/aop/ca.crt (must exist for optional/require)
# TLS_CLIENT_AUTH=require (when the CA file exists, else off)
# HEALTH_PORT=8081
# TLS_RELOAD_INTERVAL=60
