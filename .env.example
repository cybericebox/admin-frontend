# Required hosts (bare host, no scheme). Copy to .env and set; a missing one fails the build.
NEXT_PUBLIC_MAIN_HOST=cybericebox.example
NEXT_PUBLIC_API_HOST=api.cybericebox.example
NEXT_PUBLIC_ID_HOST=id.cybericebox.example
NEXT_PUBLIC_ADMIN_HOST=admin.cybericebox.example
NEXT_PUBLIC_EXERCISES_HOST=exercises.cybericebox.example
NEXT_PUBLIC_EVENT_DOMAIN=cybericebox.example
# Domain attribute of the shared theme/consent cookies.
NEXT_PUBLIC_COOKIE_DOMAIN=cybericebox.example
# Support mailbox of the «Send feedback» link.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
DEV_ALLOWED_ORIGINS=
